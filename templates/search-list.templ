package templates

// Search is one logged search, preformatted for display.
type Search struct {
	Query string
	When  string
}

// SearchList is the search log fragment. The handler swaps it into
// #search-results on htmx submits; the index page embeds it for plain loads.
templ SearchList(searches []Search) {
	if len(searches) > 0 {
		<ul>
			for _, s := range searches {
				<li>
					{ s.Query }<span class="when">{ s.When }</span>
				</li>
			}
		</ul>
	}
}

