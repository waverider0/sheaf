package templates

templ IndexPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>SHEAF</title>
			<style>
				body {
					font-family: system-ui, sans-serif;
					margin: 0;
					min-height: 100vh;
					display: flex;
					flex-direction: column;
					align-items: center;
				}
				main {
					flex: 1;
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					width: 100%;
				}
				.logo {
					font-size: 5rem;
					font-weight: 700;
					letter-spacing: 0.12em;
					margin-bottom: 2rem;
				}
				form {
					width: min(36rem, 90vw);
				}
				input {
					width: 100%;
					box-sizing: border-box;
					padding: 0.9rem 1.2rem;
					font-size: 1rem;
					border: 1px solid #dfe1e5;
					border-radius: 24px;
					outline: none;
				}
				input:focus {
					box-shadow: 0 1px 6px rgba(32, 33, 36, 0.28);
				}
			</style>
		</head>
		<body>
			<main>
				<div class="logo">SHEAF</div>
				<form action="/search" method="post">
					<input type="text" name="q" placeholder="Search SHEAF" autocomplete="off" required/>
				</form>
			</main>
		</body>
	</html>
}
